{
  "builds": [
    {
      "src": "api/quote.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/spark.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/nse.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/mf.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/quote",
      "dest": "api/quote.js"
    },
    {
      "src": "/api/spark",
      "dest": "api/spark.js"
    },
    {
      "src": "/api/nse",
      "dest": "api/nse.js"
    },
    {
      "src": "/api/mf",
      "dest": "api/mf.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
